# Copy to .env (never commit it) or export these in the shell that runs your agent.
# Every key is optional: the engine renders local media without any of them.

# Magnific (Freepik) REST API — images, video, voice-over, upscale, remove background.
# Create at https://www.magnific.com/user/organization/api-keys
MAGNIFIC_API_KEY=

# ElevenLabs — voice-over with word timestamps (recommended when you want captions synced from a full narration).
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: where the bundled fonts live if you moved them (see skills/invokard-studio/scripts/fonts.py)
# INVOKARD_FONT_DIR=

# Optional: set to 1 to forbid faster-whisper from downloading models (use a local model folder with --model)
# INVOKARD_OFFLINE=
