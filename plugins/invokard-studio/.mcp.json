{
  "mcpServers": {
    "invokard-studio": {
      "command": "node",
      "args": ["dist/studio.mjs", "serve"],
      "cwd": ".",
      "env_vars": ["INVOKARD_WORKSPACE", "INVOKARD_TOOLS_DIR", "FFMPEG_PATH", "FFPROBE_PATH", "WHISPER_CPP_PATH", "WHISPER_MODEL_PATH", "HIGGSFIELD_API_KEY", "HIGGSFIELD_API_SECRET", "MAGNIFIC_API_KEY"],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 600
    }
  }
}
